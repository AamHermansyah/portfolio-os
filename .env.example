# PortfolioOS — inquiry delivery for Hire_Me.exe and Contact.exe
#
# Copy to `.env.local` and fill in ONE of the two transports below.
# With a DATABASE_URL set, a submission is stored either way and readable from
# the Terminal, so a missing transport no longer loses anything. Only when there
# is neither a transport nor a database does /api/hire answer `not_configured`
# and the apps fall back to opening the visitor's mail client.

# --- Option 1: any endpoint that accepts a JSON POST -------------------------
# Works with Formspree, Web3Forms, Zapier, n8n, Slack and Discord webhooks.
# The payload carries the individual fields plus a preformatted summary in both
# `text` (Slack, most form services) and `content` (Discord).
# Web3Forms also needs its access_key, which a plain webhook post cannot add —
# use Option 2 or a form service that authenticates by URL.
HIRE_WEBHOOK_URL=

# --- Option 2: e-mail through Resend ----------------------------------------
# HIRE_FROM_EMAIL must be on a domain verified in Resend. Left blank it uses
# Resend's shared onboarding sender, which is fine for testing only.
RESEND_API_KEY=
HIRE_TO_EMAIL=
HIRE_FROM_EMAIL=

# --- Database: Neon Postgres via Prisma ----------------------------------
# `neon link` writes all three into `.env` for you (that file is gitignored);
# set them by hand only when deploying somewhere the Neon CLI doesn't run.
#
# DATABASE_URL is the *pooled* endpoint — the `-pooler` host. That is what the
# app uses at runtime through the Neon driver adapter in lib/prisma.ts.
DATABASE_URL=

# The direct endpoint, same database without PgBouncer in front. Prisma Migrate
# needs it: it takes a session-level advisory lock the pooler cannot hold.
# See prisma7.config.ts.
DATABASE_URL_UNPOOLED=

# Which Neon branch the two URLs above point at. Informational.
NEON_BRANCH=

# --- Terminal administration -------------------------------------------------
# Content is edited from the Terminal app, not a web dashboard. Sign in there
# with `sudo login --admin`; `sudo setup --admin` creates the first administrator
# and prompts you to create a recovery PIN stored securely in the database.
# `sudo reset --admin` recovers a forgotten password with that PIN.
#
# Signing key for the session token. At least 32 characters. Left blank, the
# admin commands answer `not_configured` rather than falling back to a
# per-process random key, which would issue tokens that verify on one serverless
# instance and are rejected by the next.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN_SECRET=

